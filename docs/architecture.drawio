<mxfile host="app.diagrams.net"><diagram name="Blended RAG architecture"><mxGraphModel dx="1180" dy="565" grid="1" gridSize="10" pageWidth="1180" pageHeight="565"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="OFFLINE  ·  build once per corpus" style="rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1160" height="240" as="geometry"/></mxCell><mxCell id="3" value="ONLINE  ·  per question, CPU only (165 ms p50)" style="rounded=1;arcSize=3;fillColor=#eef4fb;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="10" y="265" width="1160" height="290" as="geometry"/></mxCell><mxCell id="g_score" value="Score chunks of routed contract(s)" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontColor=#3a5a8c;" vertex="1" parent="1"><mxGeometry x="690" y="290" width="240" height="205" as="geometry"/></mxCell><mxCell id="b_corpus" value="&lt;b&gt;Contracts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;LegalBench-RAG-mini&lt;br&gt;72 docs · 8.7M chars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="170" height="80" as="geometry"/></mxCell><mxCell id="b_chunk" value="&lt;b&gt;Heading-aware chunker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;≤500 chars, no overlap&lt;br&gt;exact char offsets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="250" y="45" width="190" height="70" as="geometry"/></mxCell><mxCell id="b_rindex" value="&lt;b&gt;Router index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;BM25 over contract&lt;br&gt;name + first 2k chars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="250" y="160" width="190" height="70" as="geometry"/></mxCell><mxCell id="b_ctx" value="&lt;b&gt;Context prefix&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&quot;title | section&quot;&lt;br&gt;+ chunk text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="45" width="190" height="70" as="geometry"/></mxCell><mxCell id="b_enc" value="&lt;b&gt;Encode chunks&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;bge-small (dense)&lt;br&gt;SPLADE++ (sparse)&lt;br&gt;Kaggle T4, ~6 min · 26 MB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="35" width="200" height="100" as="geometry"/></mxCell><mxCell id="b_q" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&quot;Consider the merger&lt;br&gt;between X and Y; where&lt;br&gt;is the No-Shop clause?&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="355" width="170" height="90" as="geometry"/></mxCell><mxCell id="b_route" value="&lt;b&gt;1 · Route: which contract?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;max idf of name word in query&lt;br&gt;+ preamble BM25&lt;br&gt;top-1 correct 99.6%&lt;br&gt;keeps ≤3 close contracts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="250" y="345" width="210" height="110" as="geometry"/></mxCell><mxCell id="b_dense" value="&lt;b&gt;Dense scorer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;bge-small cosine&lt;br&gt;(query encoded on CPU, ONNX)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="325" width="200" height="70" as="geometry"/></mxCell><mxCell id="b_sparse" value="&lt;b&gt;SPLADE scorer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;learned term weights&lt;br&gt;sparse dot product&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="410" width="200" height="70" as="geometry"/></mxCell><mxCell id="b_rrf" value="&lt;b&gt;2 · Rank: RRF fusion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Σ 1 / (60 + rank)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="965" y="295" width="190" height="80" as="geometry"/></mxCell><mxCell id="b_out" value="&lt;b&gt;Top-k cited spans&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;doc · char offsets · section&lt;br&gt;R@64 81.9 · P@1 13.5&lt;br&gt;optional: ask --llm claude&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="965" y="400" width="190" height="100" as="geometry"/></mxCell><mxCell id="b_eval" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;char-level P@k / R@k vs gold spans · dev/test split by document&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="507" width="370" height="38" as="geometry"/></mxCell><mxCell id="4" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="b_corpus" target="b_chunk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="b_corpus" target="b_rindex"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="b_chunk" target="b_ctx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="b_ctx" target="b_enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" style="endArrow=block;html=1;dashed=1;strokeColor=#444444;" edge="1" parent="1" source="b_rindex" target="b_route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" style="endArrow=block;html=1;dashed=1;strokeColor=#444444;" edge="1" parent="1" source="b_enc" target="g_score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="b_q" target="b_route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="b_route" target="g_score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="g_score" target="b_rrf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" style="endArrow=block;html=1;strokeColor=#444444;" edge="1" parent="1" source="b_rrf" target="b_out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" style="endArrow=block;html=1;dashed=1;strokeColor=#444444;" edge="1" parent="1" source="b_out" target="b_eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="BM25 + IBM templates do routing only:&lt;br&gt;removing BM25 from ranking gave +2.7 R@8" style="text;html=1;fontStyle=2;fontColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="466" width="300" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
